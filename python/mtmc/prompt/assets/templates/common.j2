- DO NOT use "tl.relu", NO "tl.relu", NO "tl.math.relu", write it by '(tl.exp(2.0 * x) - 1) / (tl.exp(2.0 * x) + 1)'
- DO NOT use "tl.tanh", NO "tl.tanh", NO "tl.math.tanh"
- DO NOT use "tl.conv2d", NO "tl.conv2d", NO "tl.math.conv2d"
- DO NOT use "tl.static_alloc", NO "tl.static_alloc"
- DO NOT use "tl.inf", NO "tl.inf". NO "tl.math.inf"
- DO NOT use "tl.unpack", NO "tl.unpack"
- DO NOT use "tl.num_program_ids", NO "tl.num_program_ids" API
- DO NOT use "tl.libdevice", NO "tl.libdevice" API
- DO NOT use "tl.mean", NO "tl.mean", NO "tl.math.mean"
- DO NOT use "tl.mul", NO "tl.mul", NO "tl.math.mul"
{% endset %}

